{
  "name": "@chill-desktop/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run chill-desktop:serve",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx test $npm_config_project --testFile=*.component.spec.ts --skip-nx-cache --watch",
    "test:file:watch": "nx test $npm_config_project --testFile=$npm_config_file --skip-nx-cache --watch",
    "build": "nx run-many --target=build --all --configuration=production",
    "format": "prettier --write \"**/*.{ts,js,html,scss,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,html,scss,css,json,md}\""
  },
  "private": true,
